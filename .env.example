# Azure Communication Services
ACS_CONNECTION_STRING=endpoint=https://<your-resource>.communication.azure.com/;accesskey=<your-key>

# Phone number purchased from Azure Communication Services (E.164 format)
ACS_PHONE_NUMBER=+1XXXXXXXXXX

# Callback URL - Azure needs to reach this endpoint for call events
# Use ngrok or a public URL during development (e.g., https://xxxx.ngrok.io)
CALLBACK_URI=https://your-public-url.com

# Optional: Target phone number to call (E.164 format)
TARGET_PHONE_NUMBER=+1XXXXXXXXXX
